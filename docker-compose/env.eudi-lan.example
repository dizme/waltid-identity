# Frammento da integrare in `waltid-identity/docker-compose/.env`.
# Copiare queste righe (o i valori) nel proprio `.env` e impostare SERVICE_HOST all’IPv4 LAN del PC (quello raggiungibile dal telefono).
#
# VERIFIER_DNS_NAME deve coincidere con:
#   - il SAN DNS del certificato in verifier-service.conf (x5c) e key;
#   - convenzione nip.io: verifier.<IPv4-con-trattini>.nip.io (es. 192.168.1.8 → 192-168-1-8).
#
# Il processo Java del verifier riceve queste variabili via `env_file:` in docker-compose.yaml
# e le usa per sostituire ${VERIFIER_DNS_NAME} / ${VERIFIER_API2_PORT} nei file HOCON montati.

SERVICE_HOST=192.168.1.8

ISSUER_API_TLS_PORT=7443
ISSUER_API_PORT=7002
VERIFIER_API2_PORT=7004

VERIFIER_DNS_NAME=verifier.192-168-1-8.nip.io
